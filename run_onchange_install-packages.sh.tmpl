{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# ~/.brew/Brewfile hash: {{ include "dot_brew/Brewfile" | sha256sum }}

# Install Homebrew packages
if command -v brew &> /dev/null; then
    # Newer Homebrew refuses to load formulae/casks from untrusted third-party
    # taps, which aborts `brew bundle` mid-run. Trust every tap declared in the
    # Brewfile first (skipped on older brew versions without `brew trust`).
    # Warn instead of silencing failures: a tap that fails to trust is the
    # likeliest reason the bundle below aborts.
    if brew trust --help &> /dev/null; then
        awk -F'"' '/^tap /{print $2}' ~/.brew/Brewfile | while read -r tap; do
            _trust_err=$(brew trust --tap "$tap" < /dev/null 2>&1) \
                || echo "Warning: failed to trust tap: $tap: $_trust_err" >&2
        done
    fi

    echo "Installing Homebrew packages from Brewfile..."
    # Record failure but keep going so the rest of the script (oh-my-zsh)
    # still runs; the exit at the bottom fails the script afterwards. A
    # swallowed failure here latches: chezmoi won't re-run the script until
    # the Brewfile changes, leaving packages missing for weeks. Exiting
    # non-zero makes chezmoi report the failure and retry on every apply.
    _bundle_failed=0
    if ! brew bundle --file=~/.brew/Brewfile; then
        echo "Error: brew bundle failed; packages are missing. Fix and re-run 'chezmoi apply'." >&2
        _bundle_failed=1
    fi
else
    echo "Homebrew not found. Skipping Brewfile installation."
fi

# Install oh-my-zsh
function is_zsh_shell {
  [ "$SHELL" == "/bin/zsh" ]
}

function is_oh_my_zsh_installed {
  [ -d "$HOME/.oh-my-zsh" ]
}

if is_zsh_shell; then
  if ! is_oh_my_zsh_installed; then
    echo "Installing oh-my-zsh..."
    /bin/sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
    echo "oh-my-zsh installed successfully."
  else
    echo "oh-my-zsh is already installed."
  fi
else
  echo "zsh is not the current shell. Please change your shell to zsh and try again."
fi

# asdf itself is installed via Homebrew (see dot_brew/Brewfile). Its data dir
# (~/.asdf: plugins, installs, shims) is created on first use by asdf 0.16+.

# Deferred failure from the brew bundle step above (default 0 covers the
# no-brew path). Must stay the last line so everything else has run first.
exit "${_bundle_failed:-0}"
{{ end -}}
