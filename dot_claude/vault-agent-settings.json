{
  "$comment": "Settings for UNATTENDED vault agent runs (cron/scheduled). Use with: claude --settings ~/.claude/vault-agent-settings.json. Deliberately stricter than ~/.claude/settings.json, which stays permissive for interactive work. An unattended agent gets a sandbox, no bypassPermissions, and an explicit deny list -- the pkms plugin agents' prompt rules ('moves are no-clobber', 'never overwrite') are prose, and prose does not hold. pkms subcommands are enumerated rather than wildcarded: the allowed set only reads, or writes snapshot-wrapped inside an already-registered vault. Excluded on purpose: 'pkms secret' (mutates the OS keyring), 'pkms init' (moves the registered-vault fence itself), 'pkms auth'/'pkms mcp'. Named residual: 'pkms ingest' can fetch URLs -- scheduled pull-ingest needs it, so it is the one deliberate network channel in an otherwise curl/wget-denied profile.",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(//Users/rdegges/Vault/**)",
      "Edit(//Users/rdegges/Vault/**)",
      "Write(//Users/rdegges/Vault/**)",
      "Bash(pkms query:*)",
      "Bash(pkms lint:*)",
      "Bash(pkms profile:*)",
      "Bash(pkms snapshot:*)",
      "Bash(pkms undo:*)",
      "Bash(pkms history:*)",
      "Bash(pkms ingest:*)",
      "Bash(pkms doctor:*)",
      "Bash(pkms version:*)",
      "Bash(git -C /Users/rdegges/Vault/Personal status:*)",
      "Bash(git -C /Users/rdegges/Vault/Personal diff:*)",
      "Bash(git -C /Users/rdegges/Vault/Personal log:*)",
      "Bash(git -C /Users/rdegges/Vault/Personal rev-parse:*)",
      "Bash(git -C /Users/rdegges/Vault/Personal add:*)",
      "Bash(git -C /Users/rdegges/Vault/Personal commit:*)",
      "Bash(git -C /Users/rdegges/Vault/Work status:*)",
      "Bash(git -C /Users/rdegges/Vault/Work diff:*)",
      "Bash(git -C /Users/rdegges/Vault/Work log:*)",
      "Bash(git -C /Users/rdegges/Vault/Work rev-parse:*)",
      "Bash(git -C /Users/rdegges/Vault/Work add:*)",
      "Bash(git -C /Users/rdegges/Vault/Work commit:*)",
      "Bash(pgrep:*)",
      "Bash(mv -n:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(chezmoi:*)",
      "Bash(crontab:*)",
      "Write(//Users/rdegges/.claude/**)",
      "Edit(//Users/rdegges/.claude/**)",
      "Write(//Users/rdegges/.local/share/chezmoi/**)",
      "Edit(//Users/rdegges/.local/share/chezmoi/**)",
      "Write(//Users/rdegges/.ssh/**)",
      "Read(//Users/rdegges/.ssh/**)",
      "Read(//Users/rdegges/.aws/**)",
      "Read(//Users/rdegges/.config/gh/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  },
  "skipDangerousModePermissionPrompt": false
}
