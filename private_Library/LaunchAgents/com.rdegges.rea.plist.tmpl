{{- /* Update REA (rea.tools), an npm global on the asdf Node, and refresh its agent
     registrations and skill. On failure the script writes ~/.cron/logs/rea.FAILED,
     which every new shell prints. Daily at 10:25, not :15, so it rarely overlaps
     with the hourly `chezmoi update`, which runs the same script on a Node bump. */ -}}
{{ template "launchagent.plist" (dict
	"label" "com.rdegges.rea"
	"schedule" (list (dict "Hour" 10 "Minute" 25))
	"command" `{ date; $HOME/.cron/rea-update.sh; } > $HOME/.cron/logs/rea.log 2>&1`
	"home" .chezmoi.homeDir) -}}
