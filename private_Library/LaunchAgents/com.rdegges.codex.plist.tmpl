{{- /* Update the official standalone Codex CLI using its built-in updater. Use the
     explicit path so an asdf shim or old Homebrew install cannot take precedence.
     Hourly at :20; stdin is closed so this stays non-interactive. */ -}}
{{ template "launchagent.plist" (dict
	"label" "com.rdegges.codex"
	"schedule" (list (dict "Minute" 20))
	"command" `{ date; "$HOME/.local/bin/codex" update < /dev/null; } > "$HOME/.cron/logs/codex.log" 2>&1`
	"home" .chezmoi.homeDir) -}}
