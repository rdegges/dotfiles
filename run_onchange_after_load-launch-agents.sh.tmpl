{{- if eq .chezmoi.os "darwin" -}}
{{- /* Agents for the homelab server Mac only. .chezmoiignore skips their plists
     under the same condition, so this list must match it; `index` reads a
     missing key as false. */ -}}
{{- $homelabOnly := list "com.rdegges.tailscale-watchdog" "com.rdegges.app-update" -}}
{{- /* Agents for personal Macs only, skipped when `work` is true (a missing key
     counts as false). .chezmoiignore skips their plists under the same
     condition; keep the two lists equal. */ -}}
{{- $notWork := list "com.rdegges.claude-remote-control" -}}
{{- /* Always-on services (KeepAlive). The loader never reloads a loaded one;
     each has its own run_onchange_after_restart-<job>.sh.tmpl. */ -}}
{{- $services := list "com.rdegges.claude-remote-control" -}}
{{- $agents := list -}}
{{- range glob (joinPath .chezmoi.sourceDir "private_Library/LaunchAgents/*.plist.tmpl") -}}
{{-   if or (index $ "homelab") (not (has (base . | trimSuffix ".plist.tmpl") $homelabOnly)) -}}
{{-     if not (and (index $ "work") (has (base . | trimSuffix ".plist.tmpl") $notWork)) -}}
{{-       $agents = append $agents . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
#!/bin/bash
# launchagent.plist hash: {{ include ".chezmoitemplates/launchagent.plist" | sha256sum }}
{{- range $agents }}
# {{ base . }} hash: {{ include . | sha256sum }}
{{- end }}
#
# (Re)load the scheduled jobs' launchd agents whenever an agent or the shared
# template changes. This is an after_ script, so ~/Library/LaunchAgents and the
# ~/.cron scripts the jobs run are already written. chezmoi does not delete a
# target when its source goes away, so to retire a job, also list its plist in
# .chezmoiremove; any loaded com.rdegges.* label not managed here is booted out.
# Homelab-only agents are not managed here unless `homelab` is true, so turning
# the flag off boots them out (their plist files stay; see the README).
# Personal-only agents are not managed here when `work` is true, in the same way.
# A managed job that is running, or whose state cannot be read, is left alone
# and the run fails, so the next apply reloads it.
# A service (always running) is never reloaded here: a loaded one, or one that
# `launchctl disable` turned off, is left alone and the run does not fail; one
# that is not loaded is bootstrapped. Its own restart script applies a change.
#
# Every launchctl call is bounded with a timeout, like the old crontab
# installer: this runs from the hourly `chezmoi update` job, where nobody can
# answer a prompt. A failed load exits non-zero, so chezmoi retries on the next
# apply and the chezmoi.FAILED banner shows it.
set -uo pipefail

labels=(
{{- range $agents }}
    {{ base . | trimSuffix ".plist.tmpl" | squote }}
{{- end }}
)
services=(
{{- range $services }}
    {{ . | squote }}
{{- end }}
)

# The jobs redirect into this directory; a missing one fails every job.
mkdir -p "$HOME/.cron/logs"

TO=$(command -v gtimeout || command -v timeout || true)
run() { if [ -n "$TO" ]; then "$TO" -k 5 30 "$@"; else "$@"; fi; }

domain="gui/$(id -u)"
self=
rc=0

# bootout returns before launchd has fully removed the service, and a bootstrap
# in that window fails. Wait (at most 10s) until `launchctl print` no longer
# finds the label.
bootout() {
    local deadline=$((SECONDS + 10))
    run launchctl bootout "$domain/$1" >/dev/null 2>&1 || true
    while run launchctl print "$domain/$1" >/dev/null 2>&1; do
        if [ "$SECONDS" -ge "$deadline" ]; then
            echo "launch-agents: ERROR: $1 still loaded 10s after bootout" >&2
            return 1
        fi
        sleep 0.2
    done
}

# load_service <label>: bootstrap a service that is not loaded, unless it is
# disabled. A loaded one is left alone, also when this apply runs inside it (a
# session that the service started).
load_service() {
    local prc disabled
    if [ "$1" = "${XPC_SERVICE_NAME:-}" ]; then
        echo "launch-agents: $1 runs this apply; left alone"
        return
    fi
    run launchctl print "$domain/$1" >/dev/null 2>&1; prc=$?
    if [ "$prc" -eq 0 ]; then
        echo "launch-agents: $1 is loaded; left alone (its restart script applies changes)"
        return
    elif [ "$prc" -ne 113 ]; then
        echo "launch-agents: ERROR: launchctl print $domain/$1 failed (exit $prc); not loaded" >&2
        rc=1
        return
    fi
    if ! disabled=$(run launchctl print-disabled "$domain" 2>&1); then
        echo "launch-agents: ERROR: launchctl print-disabled $domain failed; $1 not loaded" >&2
        rc=1
        return
    fi
    if grep -qF -e "\"$1\" => disabled" -e "\"$1\" => true" <<<"$disabled"; then
        echo "launch-agents: $1 is disabled; not loaded"
        return
    fi
    if run launchctl bootstrap "$domain" "$HOME/Library/LaunchAgents/$1.plist"; then
        echo "launch-agents: loaded $1"
    else
        echo "launch-agents: ERROR: launchctl bootstrap $domain $1 failed" >&2
        rc=1
    fi
}

for label in "${labels[@]}"; do
    case " ${services[*]} " in *" $label "*) load_service "$label"; continue ;; esac
    # Booting out the job that runs this apply (the hourly chezmoi job) would
    # kill this script half way through. Load everything else, then fail so the
    # banner asks for an interactive apply.
    if [ "$label" = "${XPC_SERVICE_NAME:-}" ]; then
        self=$label
        continue
    fi
    # Never boot out a job that may be running. launchctl print exits 113 when
    # the label is not loaded; any other failure (incl. the 30s timeout) means
    # the state is unknown, so skip it like a running job. A job that starts
    # between this check and the bootout is still killed; that window is accepted.
    info=$(run launchctl print "$domain/$label" 2>&1); prc=$?
    if [ "$prc" -eq 0 ] && grep -q 'state = running' <<<"$info"; then
        echo "launch-agents: $label is running; not reloaded (the next apply retries)" >&2
        rc=1
        continue
    elif [ "$prc" -ne 0 ] && [ "$prc" -ne 113 ]; then
        echo "launch-agents: ERROR: launchctl print $domain/$label failed (exit $prc); not reloaded" >&2
        rc=1
        continue
    fi
    bootout "$label" || { rc=1; continue; }
    if run launchctl bootstrap "$domain" "$HOME/Library/LaunchAgents/$label.plist"; then
        echo "launch-agents: loaded $label"
    else
        echo "launch-agents: ERROR: launchctl bootstrap $domain $label failed" >&2
        rc=1
    fi
done

if listing=$(run launchctl print "$domain" 2>&1); then
    for label in $(grep -oE 'com\.rdegges\.[A-Za-z0-9._-]+' <<<"$listing" | sort -u); do
        case " ${labels[*]} " in *" $label "*) continue ;; esac
        [ "$label" = "${XPC_SERVICE_NAME:-}" ] && continue
        echo "launch-agents: booting out $label (no managed plist)"
        bootout "$label" || rc=1
    done
else
    echo "launch-agents: ERROR: launchctl print $domain failed; orphaned agents not checked: $listing" >&2
    rc=1
fi

if [ -n "$self" ]; then
    echo "launch-agents: $self not reloaded from inside itself; run 'chezmoi apply' interactively" >&2
    rc=1
fi
exit "$rc"
{{ end -}}
