# Oh My Zsh. The daily launchd update job keeps it current (~/.cron/update.sh),
# so its own update check stays off.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
zstyle ':omz:update' mode disabled
plugins=(
  asdf
  git
)
source $ZSH/oh-my-zsh.sh

# Set up `pipx` so all installed packages can run.
export PATH="$HOME/.local/bin:$PATH"

# Set up `go` so all installed tools can run (only if the asdf golang plugin is
# present, so fresh shells don't error before bootstrap installs it).
[ -f ~/.asdf/plugins/golang/set-env.zsh ] && source ~/.asdf/plugins/golang/set-env.zsh

# Set up `starship` prompt.
eval "$(starship init zsh)"

# Surface failed scheduled (launchd) jobs: a job that fails writes
# ~/.cron/logs/<job>.FAILED and removes it on its next success (see
# dot_cron/executable_cf-update.sh). Each line of a marker loses its control
# characters (ESC, BEL, CR, tab), so a job that writes raw CLI output cannot
# send escape sequences to the terminal. Newlines stay: a marker can be
# several lines.
for f in ~/.cron/logs/*.FAILED(N); do print -r -- $'\e[31m'"cron: ${(@F)${(@f)"$(<$f)"}//[[:cntrl:]]/}"$'\e[0m'; done
