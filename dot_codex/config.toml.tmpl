# Codex CLI config. Durable prefs only. Per-project trust entries are deliberately
# not synced because they leak absolute paths and differ per machine.
approval_policy = "never"
file_opener = "cursor"
model = "gpt-6-astra"
model_reasoning_effort = "medium"
sandbox_mode = "danger-full-access"

model_reasoning_summary = "auto"
show_raw_agent_reasoning = true
web_search = "live"

[history]
persistence = "save-all"

[notice]
hide_full_access_warning = true

{{ if not (dig "work" false .) -}}
# Parallel's Search MCP (https://parallel.ai), personal machines only, signed
# with the key that run_onchange_after_setup-parallel-mcp.sh.tmpl fetches and
# dot_zshenv exports. That script also registers Claude Code and opencode.
[mcp_servers.parallel]
url = "https://search.parallel.ai/mcp"
bearer_token_env_var = "PARALLEL_API_KEY"
{{ end -}}
