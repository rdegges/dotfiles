{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# ~/.agents/skills.txt hash: {{ include "dot_agents/skills.txt" | sha256sum }}
# Re-runs whenever the desired skills list changes.

set -euo pipefail

if ! command -v npx &> /dev/null; then
    echo "npx not found. Skipping skill installation."
    echo "Install Node.js to enable Claude Code skills."
    exit 0
fi

SKILLS_FILE="$HOME/.agents/skills.txt"

if [ ! -f "$SKILLS_FILE" ]; then
    echo "No skills list found at $SKILLS_FILE. Skipping."
    exit 0
fi

echo "Installing Claude Code skills from $SKILLS_FILE..."

# Each non-comment, non-blank line is a skill source. The `skills` tool owns its
# own lock file (~/.agents/.skill-lock.json); we only drive the desired set here.
grep -vE '^[[:space:]]*(#|$)' "$SKILLS_FILE" | while read -r source; do
    source="${source%%[[:space:]]*}"
    [ -z "$source" ] && continue
    echo "Installing skill: $source"
    npx skills add "$source" -g -y 2>&1 || echo "Warning: failed to install $source"
done

echo "Claude Code skills installation complete."
{{ end -}}
