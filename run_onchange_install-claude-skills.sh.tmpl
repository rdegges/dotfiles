{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# ~/.agents/.skill-lock.json hash: {{ include "dot_agents/dot_skill-lock.json" | sha256sum }}
# Re-runs whenever the skill lock file changes

set -euo pipefail

echo "Installing Claude Code skills from lock file..."

if ! command -v npx &> /dev/null; then
    echo "npx not found. Skipping skill installation."
    echo "Install Node.js to enable Claude Code skills."
    exit 0
fi

LOCK_FILE="$HOME/.agents/.skill-lock.json"

if [ ! -f "$LOCK_FILE" ]; then
    echo "No skill lock file found. Skipping."
    exit 0
fi

# Parse each skill source from the lock file and install it globally
for source in $(python3 -c "
import json, sys
with open('$LOCK_FILE') as f:
    lock = json.load(f)
for name, info in lock.get('skills', {}).items():
    print(info['source'])
"); do
    echo "Installing skill: $source"
    npx skills add "$source" -g -y 2>&1 || echo "Warning: failed to install $source"
done

echo "Claude Code skills installation complete."
{{ end -}}
