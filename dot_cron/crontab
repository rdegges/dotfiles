# Cron runs jobs with a minimal PATH (/usr/bin:/bin), so bare `brew`, `asdf`,
# and `pipx` below never resolved. Cron env lines don't expand variables, so
# these paths must be absolute.
PATH=/opt/homebrew/bin:/Users/rdegges/.asdf/shims:/usr/local/bin:/usr/bin:/bin

# Keep `brew` packages up-to-date.
0 10 * * * /opt/homebrew/bin/brew update --force --quiet; brew upgrade --greedy --quiet

# Keep dotfiles updated with `chezmoi`.
0 * * * * /opt/homebrew/bin/chezmoi update --force

# Keep `asdf` package manager updated.
0 * * * * asdf plugin update --all

# Keep all `pipx` packages updated.
0 * * * * $HOME/.asdf/shims/pipx upgrade-all

# Clean up old `brew` package versions.
0 11 * * 6 /opt/homebrew/bin/brew cleanup --prune=30 -q

# Keep Oh My Zsh updated.
0 10 * * 6 /usr/bin/env zsh -c 'cd $HOME/.oh-my-zsh && git pull -q'
