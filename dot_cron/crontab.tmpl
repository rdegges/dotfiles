# Managed by chezmoi (source: dot_cron/crontab.tmpl). Do not edit in place.
#
# Cron runs jobs with a minimal environment and no shell profile. The env
# ASSIGNMENT lines below are literal -- cron does NOT expand $VARS in them -- so
# absolute paths are required; {{ "{{ .chezmoi.homeDir }}" }} is filled in by chezmoi at
# apply time. COMMAND lines are run via /bin/sh, so $HOME does expand there.
#
# Commands are bare (resolved via PATH) rather than hardcoded to /opt/homebrew,
# so this works on both Apple Silicon (/opt/homebrew) and Intel (/usr/local).
SHELL=/bin/sh
PATH={{ .chezmoi.homeDir }}/.asdf/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# Homebrew, non-interactively: quiet the env hints, skip the redundant implicit
# auto-update (we run `brew update` explicitly), and never block on 6.x "ask
# mode" (no-TTY already skips the prompt; this is belt-and-suspenders).
HOMEBREW_NO_ENV_HINTS=1
HOMEBREW_NO_AUTO_UPDATE=1
HOMEBREW_NO_ASK=1

# Update Homebrew + upgrade all formulae and casks. Plain `brew upgrade` (no
# args) already covers both. No --greedy: it redundantly re-downloads apps that
# update themselves. --no-quit so an unattended run never closes an app you're
# using. Daily at 10:00.
0 10 * * * { date; brew update --quiet && brew upgrade --quiet --no-quit; } > $HOME/.cron/logs/brew.log 2>&1

# Snapshot every Obsidian vault into git. Hourly at :05, ahead of the chezmoi
# pull at :15 so a snapshot never races a dotfiles-driven change. This is the
# only undo available for the vaults -- Obsidian Sync keeps no usable history.
5 * * * * { date; $HOME/.cron/vault-snapshot.sh; } > $HOME/.cron/logs/vault-snapshot.log 2>&1

# Sync dotfiles from the repo (git pull + apply). Hourly at :15.
15 * * * * { date; chezmoi update --force; } > $HOME/.cron/logs/chezmoi.log 2>&1

# Refresh asdf plugin repos (installed tool versions stay pinned by
# .tool-versions). Hourly at :30.
30 * * * * { date; asdf plugin update --all; } > $HOME/.cron/logs/asdf.log 2>&1

# Upgrade all pipx-managed apps. Hourly at :45.
45 * * * * { date; pipx upgrade-all; } > $HOME/.cron/logs/pipx.log 2>&1

# Prune Docker build cache older than 3 days and all images unused by any
# container. Recent cache stays hot (fast rebuilds on active projects) while
# the long tail can't creep back to the 100G+ it once reached; pruned images
# just re-pull on demand. Skips when Docker Desktop isn't running rather than
# logging a connection error. Daily at 09:00.
0 9 * * * { date; if docker info >/dev/null 2>&1; then docker builder prune -af --filter until=72h; docker image prune -af; else echo "docker not running; skipped"; fi; } > $HOME/.cron/logs/docker-prune.log 2>&1

# Prune brew cache older than 30 days (also autoremoves now-unused deps by
# default in 6.x). Saturday at 11:00.
0 11 * * 6 { date; brew cleanup --prune=30 --quiet; } > $HOME/.cron/logs/brew-cleanup.log 2>&1

# Update Oh My Zsh. Saturday at 10:00.
0 10 * * 6 { date; zsh -c 'cd $HOME/.oh-my-zsh && git pull -q'; } > $HOME/.cron/logs/oh-my-zsh.log 2>&1
