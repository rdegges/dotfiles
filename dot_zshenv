# Sourced by every zsh invocation, including non-interactive SSH commands
# (`ssh host cmd`), which skip .zprofile and .zshrc. Without this, remote
# tooling like herdr's --remote bridge can't resolve brew- or ~/.local/bin-
# installed binaries. Harmless duplication with .zprofile/.zshrc in
# interactive shells.
# Both Homebrew prefixes are listed; only the one for this Mac's architecture
# exists (Apple Silicon = /opt/homebrew, Intel = /usr/local), the other is a
# harmless no-op.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:$PATH"

# 1Password CLI finds the desktop app by reading a settings file in 1Password's
# Group Container, which macOS blocks without Full Disk Access. op then falls
# back to `eval $(op signin)` with the master password. Forcing app integration
# skips that read without granting the terminal Full Disk Access.
# Over SSH (no GUI to approve), opt out for the whole session first: export OP_BIOMETRIC_UNLOCK_ENABLED=false; eval $(op signin)
export OP_BIOMETRIC_UNLOCK_ENABLED=true

# Parallel Search MCP key for Codex and other terminal tools, written once from
# 1Password by run_onchange_after_setup-parallel-mcp.sh.tmpl (personal machines).
# Claude Code reads the file itself: GUI apps never source this file.
[ -r "$HOME/.config/parallel/api-key" ] && export PARALLEL_API_KEY="$(<"$HOME/.config/parallel/api-key")"

# Bypass mode (settings.json permissions.defaultMode) still blocks a few destructive
# commands such as `rm -rf ~`. This lifts that last block on every box, by
# choice. It must live here: Claude Code reads it only from the environment it
# starts in and ignores it in any settings file. GUI apps never source this
# file, so the desktop app keeps the guard. settings.json permissions.defaultMode
# starts every session in bypass mode. Any permissions deny rule switches the
# waiver off for that session; that is how vault-agent-settings.json keeps the
# guard. Remove this line to get the guard back.
export CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS=1
