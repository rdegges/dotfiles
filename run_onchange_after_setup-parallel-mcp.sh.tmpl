{{- if and (eq .chezmoi.os "darwin") (not .work) -}}
#!/bin/bash
# Register Parallel's Search MCP server (https://parallel.ai) for Claude Code
# and opencode on personal machines, signed with my Parallel API key. Both
# tools keep their user-level MCP servers in state files chezmoi must not own
# (~/.claude.json, ~/.config/opencode/opencode.json, which `rea setup` also
# writes), so this drives each CLI instead. Codex's entry is in
# dot_codex/config.toml.tmpl, because chezmoi owns that file.
#
# The key comes from 1Password once per machine, into a 0600 file. It is read
# here, not with a onepasswordRead template, because the hourly `chezmoi
# update` job cannot approve a Touch ID prompt. Neither config stores the key
# itself: both read the file each time they connect. Claude Code does it
# through a headersHelper, because the desktop app is started by launchd and
# never sees PARALLEL_API_KEY from dot_zshenv (a ${PARALLEL_API_KEY} header
# reached Parallel as literal text and got a 401). opencode does it through
# {file:...}.
#
# A helper that fails or sends an empty token makes Claude Code connect to
# Parallel anonymously with no warning, so a missing or empty key file sends a
# sentinel token instead: that fails with a visible 401.
#
# This is an `after_` script so it runs after run_once_install-claude-code.
set -uo pipefail

CLAUDE="$HOME/.local/bin/claude"
URL="https://search.parallel.ai/mcp"
KEY_FILE="$HOME/.config/parallel/api-key"
KEY_REF="op://Private/Parallel/credential"
status=0

if [ ! -s "$KEY_FILE" ]; then
  mkdir -p "${KEY_FILE%/*}" || exit 1
  key="$(op read "$KEY_REF")" || {
    echo "parallel-mcp: could not read $KEY_REF; sign in to 1Password (op), then re-run chezmoi apply" >&2
    exit 1
  }
  [ -n "$key" ] || {
    echo "parallel-mcp: $KEY_REF is empty; put the key in the item's credential field, then re-run chezmoi apply" >&2
    exit 1
  }
  # umask sets the mode only for a new file, so drop any old one first.
  rm -f "$KEY_FILE" || exit 1
  (umask 077 && printf '%s\n' "$key" > "$KEY_FILE") || exit 1
  echo "parallel-mcp: wrote $KEY_FILE; open a new shell so PARALLEL_API_KEY is set"
fi
chmod 600 "$KEY_FILE" || exit 1

if [ ! -x "$CLAUDE" ]; then
  echo "parallel-mcp: $CLAUDE not found; install Claude Code, then re-run chezmoi apply" >&2
  status=1
else
  # Quoted heredoc: Claude Code must store the helper command, not the key.
  # No static `headers`: the helper must be the only Authorization source.
  json="$(cat <<'EOF'
{"type":"http","url":"https://search.parallel.ai/mcp","headersHelper":"k=$(cat ~/.config/parallel/api-key 2>/dev/null); printf '{\"Authorization\":\"Bearer %s\"}' \"${k:-missing-parallel-key-file}\""}
EOF
)"
  # `mcp get` cannot show a headersHelper, so always replace the user-scope
  # entry. `remove --scope user` reaches it even behind a local or project
  # entry, which belong to a project and stay. If the remove fails for a real
  # reason, add-json fails with "already exists", so this still fails closed.
  "$CLAUDE" mcp remove --scope user parallel >/dev/null 2>&1
  if out="$("$CLAUDE" mcp add-json --scope user parallel "$json" 2>&1)"; then
    printf '%s\n' "$out"
  else
    printf '%s\n' "$out" >&2
    status=1
  fi
fi

# `opencode mcp add --global` replaces an existing `parallel` entry and keeps
# the rest of the file. Run it from $HOME so no project config is picked up.
if ! command -v opencode >/dev/null 2>&1; then
  echo "parallel-mcp: opencode not found on PATH; install it (Brewfile), then re-run chezmoi apply" >&2
  status=1
else
  (cd "$HOME" && opencode mcp add --global --url "$URL" \
    --header 'Authorization=Bearer {file:~/.config/parallel/api-key}' parallel) || status=1
fi

exit "$status"
{{ end -}}
