{{- /*
  One per-user launchd agent for a scheduled job (or an always-on service; see
  `service` below). Each
  private_Library/LaunchAgents/com.rdegges.<job>.plist.tmpl calls this with a dict:

    label     com.rdegges.<job>, the same as the file name.
    command   the /bin/sh command line, byte for byte what the old crontab ran:
              `{ date; <job>; } > $HOME/.cron/logs/<job>.log 2>&1`.
    schedule  a list of StartCalendarInterval dicts (Minute, Hour, Weekday;
              a missing key means "every", like a cron `*`). Not read when
              `service` is true.
    home      .chezmoi.homeDir.

  launchd, not cron: cron skips a job whose time passes while the Mac sleeps,
  and launchd runs it once on the next wake. Loading an agent also does not
  touch TCC-protected /var/at/tabs, which made the unattended crontab install
  hang.

  EnvironmentVariables are literal -- launchd does NOT expand $VARS in them --
  so absolute paths are required. The command runs via /bin/sh -c, so $HOME
  does expand there (launchd sets HOME). Commands are bare (resolved via PATH)
  rather than hardcoded to /opt/homebrew, so this works on both Apple Silicon
  (/opt/homebrew) and Intel (/usr/local). ~/.local/bin must be on PATH: the
  installer that `codex update` runs appends a PATH block to ~/.zprofile
  whenever it is missing, and the next `chezmoi update` deletes that block.
  /usr/sbin and /sbin must be on PATH too: macOS ships ioreg, sysctl, scutil,
  lsof, and route only there, and launchd's default PATH has neither. The
  Remote Control server's sessions inherit this PATH as well.

  Homebrew, non-interactively: quiet the env hints, skip the redundant implicit
  auto-update (the brew job runs `brew update` explicitly), and never block on
  6.x "ask mode" (no-TTY already skips the prompt; this is belt-and-suspenders).

  No StandardOutPath/StandardErrorPath: the command's own redirect writes the
  log and truncates it each run, as under cron. Every string goes through
  `html` so a command's quotes, `&&`, and `>` stay valid XML.

  service   optional; true makes an always-on service instead of a scheduled
            job: no schedule (leave it out), RunAtLoad and KeepAlive true (launchd
            starts it at load and again whenever it exits), ThrottleInterval 60
            (a crash loop restarts at most once a minute), ProcessType
            Interactive. Its command appends to its log (`>>`), because the
            process is long-lived. Read with `index`, so a missing key is
            false: an agent without it renders byte for byte as before the key
            existed (tests/cron/launch-agents.test.mjs checks this).
*/ -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by chezmoi (source: private_Library/LaunchAgents/{{ .label | html }}.plist.tmpl). Do not edit in place. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>{{ .label | html }}</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>{{ .command | html }}</string>
	</array>
{{- if not (index . "service") }}
	<key>StartCalendarInterval</key>
	<array>
{{- range .schedule }}
		<dict>
{{- range $key, $value := . }}
			<key>{{ $key | html }}</key>
			<integer>{{ $value }}</integer>
{{- end }}
		</dict>
{{- end }}
	</array>
{{- end }}
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{ .home | html }}/.asdf/shims:{{ .home | html }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>HOMEBREW_NO_ENV_HINTS</key>
		<string>1</string>
		<key>HOMEBREW_NO_AUTO_UPDATE</key>
		<string>1</string>
		<key>HOMEBREW_NO_ASK</key>
		<string>1</string>
	</dict>
{{- if index . "service" }}
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
{{- else }}
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
{{- end }}
</dict>
</plist>
