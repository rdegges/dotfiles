# Himalaya CLI config
# Docs: https://github.com/pimalaya/himalaya
#
# This file is a chezmoi template. The Snyk account is gated behind the
# `work` data variable so it only renders on the work laptop. To enable
# on a machine, add `work = true` under `[data]` in
# ~/.config/chezmoi/chezmoi.toml (chezmoi's local config — not synced).
#
# Passwords are fetched from the macOS Keychain at runtime via `security(1)`.
# Store them once with:
#   read -rs "?Paste app password: " PW; \
#     security add-generic-password -U -s <service> -a <account> -w "$PW"; \
#     unset PW

# The name "icloud" is historical: this account now uses Fastmail. The name
# stays so that existing commands and scripts keep working.
[accounts.icloud]
default = true
email = "r@rdegges.com"
display-name = "Randall Degges"

# Folder aliases — map himalaya's logical names to Fastmail's IMAP folder names.
folder.aliases.inbox = "INBOX"
folder.aliases.sent = "Sent"
folder.aliases.drafts = "Drafts"
folder.aliases.trash = "Trash"

# ----- Receiving (IMAP) -----
backend.type = "imap"
backend.host = "imap.fastmail.com"
backend.port = 993
backend.encryption.type = "tls"
backend.login = "rdegges@sent.com"
backend.auth.type = "password"
backend.auth.cmd = "security find-generic-password -s himalaya-fastmail -a rdegges@sent.com -w"

# ----- Sending (SMTP) -----
message.send.backend.type = "smtp"
message.send.backend.host = "smtp.fastmail.com"
message.send.backend.port = 465
message.send.backend.encryption.type = "tls"
message.send.backend.login = "rdegges@sent.com"
message.send.backend.auth.type = "password"
message.send.backend.auth.cmd = "security find-generic-password -s himalaya-fastmail -a rdegges@sent.com -w"

# Save a copy of every sent message to Sent on the server.
message.send.save-copy = true

# Signature — appended to all outgoing messages (new, reply, reply-all, forward).
# Himalaya prepends the standard "-- " sig delimiter (RFC 3676) automatically.
signature = """
Randall Degges
https://rdegges.com
"""

