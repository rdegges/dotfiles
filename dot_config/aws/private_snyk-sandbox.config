# Managed by chezmoi (dotfiles: dot_config/aws/private_snyk-sandbox.config).
# Edits here are overwritten on the next apply. The work-only `aws` zsh function
# points AWS_CONFIG_FILE at this file for snyk-sandbox calls, so nothing in
# ~/.aws/config or ~/.aws/credentials can change this profile.
[sso-session snyk]
sso_start_url = https://identitycenter.amazonaws.com/ssoins-6804c38450c29714
sso_region = eu-west-1
sso_registration_scopes = sso:account:access

[profile snyk-sandbox]
sso_session = snyk
sso_account_id = 597564118722
sso_role_name = AWSPowerUserAccess
region = us-west-2
output = json
